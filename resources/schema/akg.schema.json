{
  "$defs": {
    "Accessor": {
      "additionalProperties": true,
      "properties": {
        "properties": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Properties"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        }
      },
      "required": [
        "schema_id"
      ],
      "title": "Accessor",
      "type": "object"
    },
    "Column": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "synonyms": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synonyms"
        },
        "value_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "Column",
      "type": "object"
    },
    "ColumnReference": {
      "additionalProperties": true,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "column"
      ],
      "title": "ColumnReference",
      "type": "object"
    },
    "ColumnUsage": {
      "additionalProperties": true,
      "properties": {
        "as": {
          "enum": [
            "measure",
            "count",
            "group",
            "filter",
            "time",
            "absence",
            "join_only",
            "output"
          ],
          "title": "As",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null,
          "description": "Filter value or threshold."
        }
      },
      "required": [
        "as"
      ],
      "title": "ColumnUsage",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": true,
      "description": "Two or more anchors compared on shared columns rather than joined to each other.",
      "properties": {
        "anchors": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Anchors",
          "type": "array"
        },
        "comparison": {
          "enum": [
            "coverage",
            "difference",
            "co_occurrence"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "shared_columns": {
          "items": {
            "$ref": "#/$defs/ColumnReference"
          },
          "minItems": 1,
          "title": "Shared Columns",
          "type": "array"
        }
      },
      "required": [
        "anchors",
        "shared_columns",
        "comparison"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": true,
      "description": "One graph dataset record, as a graph service response presents it.",
      "properties": {
        "accessor": {
          "$ref": "#/$defs/Accessor"
        },
        "columns": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Column"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "descriptor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Descriptor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "edge_groups": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/EdgeGroup"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Selected directed edges leaving this dataset.",
          "title": "Edge Groups"
        },
        "entity_definitions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/EntityDefinition"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Definitions"
        },
        "grain": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "const": "unknown",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grain"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "qualified_name": {
          "minLength": 1,
          "title": "Qualified Name",
          "type": "string"
        },
        "stats": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reserved for statistics once the graph serves them.",
          "title": "Stats"
        },
        "unknown_fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Fields"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "node_id",
        "qualified_name",
        "accessor"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "DatasetUsage": {
      "additionalProperties": true,
      "description": "Agent reasoning about one dataset.",
      "properties": {
        "columns": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/ColumnUsage"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "anchor",
                "grouping",
                "filter",
                "bridge"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "title": "DatasetUsage",
      "type": "object"
    },
    "Descriptor": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "synonyms": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synonyms"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        }
      },
      "title": "Descriptor",
      "type": "object"
    },
    "EdgeGroup": {
      "additionalProperties": true,
      "properties": {
        "entity_definitions": {
          "items": {
            "$ref": "#/$defs/GroupDefinition"
          },
          "minItems": 1,
          "title": "Entity Definitions",
          "type": "array"
        },
        "identity_id": {
          "minLength": 1,
          "title": "Identity Id",
          "type": "string"
        }
      },
      "required": [
        "identity_id",
        "entity_definitions"
      ],
      "title": "EdgeGroup",
      "type": "object"
    },
    "EdgeReference": {
      "additionalProperties": true,
      "properties": {
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "node_id": {
          "description": "The dataset that holds the directed edge.",
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "edge_id"
      ],
      "title": "EdgeReference",
      "type": "object"
    },
    "EdgeUsage": {
      "additionalProperties": true,
      "description": "Agent reasoning about one directed edge.",
      "properties": {
        "aggregate_before_join": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Aggregate the end to the start's grain before combining.",
          "title": "Aggregate Before Join"
        },
        "keep": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start or end node_id values whose unmatched rows must survive.",
          "title": "Keep"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "EdgeUsage",
      "type": "object"
    },
    "EntityDefinition": {
      "additionalProperties": true,
      "properties": {
        "conforms": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "unknown",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conforms"
        },
        "dataset_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dataset Columns",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "description_source": {
          "anyOf": [
            {
              "enum": [
                "entity",
                "column"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description Source"
        },
        "effective_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Description"
        },
        "entity_expression": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Expression"
        },
        "entity_metadata": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Metadata"
        },
        "entity_universe": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityUniverse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "identity_id": {
          "minLength": 1,
          "title": "Identity Id",
          "type": "string"
        },
        "total": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "unknown",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "unique": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "unknown",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unique"
        },
        "unknown_fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Fields"
        }
      },
      "required": [
        "identity_id",
        "dataset_columns"
      ],
      "title": "EntityDefinition",
      "type": "object"
    },
    "EntityUniverse": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "EntityUniverse",
      "type": "string"
    },
    "Gap": {
      "additionalProperties": true,
      "description": "Knowledge the objective needs that the graph cannot connect or supply.",
      "properties": {
        "datasets": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datasets"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "edges": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/EdgeReference"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edges"
        }
      },
      "required": [
        "description"
      ],
      "title": "Gap",
      "type": "object"
    },
    "GraphInfo": {
      "additionalProperties": true,
      "properties": {
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Snapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The served snapshot, as `graph.snapshot_info` returns it."
        }
      },
      "title": "GraphInfo",
      "type": "object"
    },
    "GroupDefinition": {
      "additionalProperties": true,
      "description": "One entity definition of an edge group, with its selected directed edges.",
      "properties": {
        "dataset_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dataset Columns",
          "type": "array"
        },
        "edges": {
          "description": "Directed-edge arrays at the positions the document's `edge_fields` names.",
          "items": {
            "items": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "array"
          },
          "title": "Edges",
          "type": "array"
        },
        "usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/EdgeUsage"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Agent reasoning per directed edge, keyed by `edge_id`.",
          "title": "Usage"
        }
      },
      "required": [
        "dataset_columns",
        "edges"
      ],
      "title": "GroupDefinition",
      "type": "object"
    },
    "JsonValue": {},
    "Snapshot": {
      "additionalProperties": true,
      "properties": {
        "api_version": {
          "description": "The graph API version the AKG follows.",
          "minLength": 1,
          "title": "Api Version",
          "type": "string"
        },
        "version": {
          "description": "The snapshot version the AKG was read from.",
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "version"
      ],
      "title": "Snapshot",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "The graph datasets and directed edges that serve one objective.",
  "properties": {
    "comparisons": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/Comparison"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comparisons"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/Dataset"
      },
      "title": "Datasets",
      "type": "array"
    },
    "edge_fields": {
      "description": "Names of the directed-edge array positions.",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Edge Fields",
      "type": "array"
    },
    "gaps": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/Gap"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gaps"
    },
    "graph": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraphInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "objective": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Objective"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "final"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "question",
    "edge_fields",
    "datasets"
  ],
  "title": "AkgDocument",
  "type": "object"
}
