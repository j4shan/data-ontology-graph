      "type": "object"
    },
    "RelationshipUsage": {
      "additionalProperties": true,
      "description": "Agent reasoning about one relationship.",
      "properties": {
        "aggregate_before_join": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregate Before Join"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The endpoint node_id traversal starts from.",
          "title": "From"
        },
        "keep": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Endpoint node_id values whose unmatched rows must survive.",
          "title": "Keep"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "RelationshipUsage",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": true,
      "properties": {
        "schema_fingerprint": {
          "minLength": 1,
          "title": "Schema Fingerprint",
          "type": "string"
