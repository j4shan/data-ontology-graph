  "additionalProperties": true,
  "description": "The graph datasets and relationships that serve one objective.",
  "properties": {
    "comparisons": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/Comparison"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comparisons"
    },
    "datasets": {
      "additionalProperties": {
        "$ref": "#/$defs/Dataset"
      },
      "title": "Datasets",
      "type": "object"
    },
    "gaps": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/Gap"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gaps"
    },
    "graph": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraphInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "objective": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Objective"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "relationships": {
      "additionalProperties": {
        "$ref": "#/$defs/Relationship"
      },
      "title": "Relationships",
      "type": "object"
    },
    "status": {
      "enum": [
        "draft",
        "final"
      ],
      "title": "Status",
      "type": "string"
    }
