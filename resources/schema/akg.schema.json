{
  "$defs": {
    "ColumnFacts": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "synonyms": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synonyms"
        },
        "value_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Description"
        }
      },
      "title": "ColumnFacts",
      "type": "object"
    },
    "ColumnReference": {
      "additionalProperties": true,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "column"
      ],
      "title": "ColumnReference",
      "type": "object"
    },
    "ColumnUsage": {
      "additionalProperties": true,
      "properties": {
        "as": {
          "enum": [
            "measure",
            "count",
            "group",
            "filter",
            "time",
            "absence",
            "join_only",
            "output"
          ],
          "title": "As",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null,
          "description": "Filter value or threshold."
        }
      },
      "required": [
        "as"
      ],
      "title": "ColumnUsage",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": true,
      "description": "Two or more anchors compared on shared columns rather than joined to each other.",
      "properties": {
        "anchors": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Anchors",
          "type": "array"
        },
        "comparison": {
          "enum": [
            "coverage",
            "difference",
            "co_occurrence"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "shared_columns": {
          "items": {
            "$ref": "#/$defs/ColumnReference"
          },
          "minItems": 1,
          "title": "Shared Columns",
          "type": "array"
        }
      },
      "required": [
        "anchors",
        "shared_columns",
        "comparison"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": true,
      "description": "One graph dataset, keyed by `node_id` in the document.",
      "properties": {
        "columns": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/ColumnFacts"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "edges": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DirectedEdge"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Selected directed edges leaving this dataset.",
          "title": "Edges"
        },
        "entity_definitions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/EntityDefinitionFacts"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Definitions"
        },
        "grain": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "const": "unknown",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grain"
        },
        "name": {
          "description": "descriptor.qualified_name",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source": {
          "description": "Accessor family, such as sqlite.",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "stats": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reserved for statistics once the graph serves them.",
          "title": "Stats"
        },
        "synonyms": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synonyms"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "DatasetUsage": {
      "additionalProperties": true,
      "description": "Agent reasoning about one dataset.",
      "properties": {
        "columns": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/ColumnUsage"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "anchor",
                "grouping",
                "filter",
                "bridge"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "title": "DatasetUsage",
      "type": "object"
    },
    "DirectedEdge": {
      "additionalProperties": true,
      "description": "One relationship read from the dataset that holds it, where traversal starts.\n\nA directed edge is identified by `edge_id` and `from_dataset_columns`: a relationship with\nboth endpoints on one dataset gives that dataset two directed edges.",
      "properties": {
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "from_dataset_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "From Dataset Columns",
          "type": "array"
        },
        "from_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Description"
        },
        "identity_id": {
          "minLength": 1,
          "title": "Identity Id",
          "type": "string"
        },
        "match_existence": {
          "$ref": "#/$defs/MatchExistence"
        },
        "multiplicity": {
          "$ref": "#/$defs/Multiplicity"
        },
        "reverse_match_existence": {
          "$ref": "#/$defs/MatchExistence"
        },
        "reverse_multiplicity": {
          "$ref": "#/$defs/Multiplicity"
        },
        "stats": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reserved for statistics once the graph serves them.",
          "title": "Stats"
        },
        "to_dataset_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "To Dataset Columns",
          "type": "array"
        },
        "to_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Description"
        },
        "to_node_id": {
          "minLength": 1,
          "title": "To Node Id",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "edge_id",
        "identity_id",
        "from_dataset_columns",
        "to_node_id",
        "to_dataset_columns",
        "multiplicity",
        "match_existence",
        "reverse_multiplicity",
        "reverse_match_existence"
      ],
      "title": "DirectedEdge",
      "type": "object"
    },
    "EdgeReference": {
      "additionalProperties": true,
      "properties": {
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "node_id": {
          "description": "The dataset that holds the directed edge.",
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "edge_id"
      ],
      "title": "EdgeReference",
      "type": "object"
    },
    "EdgeUsage": {
      "additionalProperties": true,
      "description": "Agent reasoning about one directed edge.",
      "properties": {
        "aggregate_before_join": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Aggregate the end to the start's grain before combining.",
          "title": "Aggregate Before Join"
        },
        "keep": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start or end node_id values whose unmatched rows must survive.",
          "title": "Keep"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "EdgeUsage",
      "type": "object"
    },
    "EntityDefinitionFacts": {
      "additionalProperties": true,
      "properties": {
        "dataset_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dataset Columns",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Effective description: the definition's own, or its single raw column's.",
          "title": "Description"
        },
        "description_source": {
          "anyOf": [
            {
              "enum": [
                "entity",
                "column"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description Source"
        },
        "entity_universe": {
          "$ref": "#/$defs/EntityUniverse"
        },
        "identity_id": {
          "minLength": 1,
          "title": "Identity Id",
          "type": "string"
        }
      },
      "required": [
        "identity_id",
        "dataset_columns",
        "entity_universe"
      ],
      "title": "EntityDefinitionFacts",
      "type": "object"
    },
    "EntityUniverse": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "EntityUniverse",
      "type": "string"
    },
    "Gap": {
      "additionalProperties": true,
      "description": "Knowledge the objective needs that the graph cannot connect or supply.",
      "properties": {
        "datasets": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datasets"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "edges": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/EdgeReference"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edges"
        }
      },
      "required": [
        "description"
      ],
      "title": "Gap",
      "type": "object"
    },
    "GraphInfo": {
      "additionalProperties": true,
      "properties": {
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Snapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The served snapshot, recorded by `akg.py init`."
        }
      },
      "title": "GraphInfo",
      "type": "object"
    },
    "JsonValue": {},
    "MatchExistence": {
      "enum": [
        "always",
        "optional",
        "unknown"
      ],
      "title": "MatchExistence",
      "type": "string"
    },
    "Multiplicity": {
      "enum": [
        "1:1",
        "1:many",
        "many:1",
        "many:many",
        "unknown"
      ],
      "title": "Multiplicity",
      "type": "string"
    },
    "Snapshot": {
      "additionalProperties": true,
      "properties": {
        "schema_fingerprint": {
          "minLength": 1,
          "title": "Schema Fingerprint",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "schema_fingerprint"
      ],
      "title": "Snapshot",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "The graph datasets and directed edges that serve one objective.",
  "properties": {
    "comparisons": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/Comparison"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comparisons"
    },
    "datasets": {
      "additionalProperties": {
        "$ref": "#/$defs/Dataset"
      },
      "title": "Datasets",
      "type": "object"
    },
    "format_version": {
      "const": 2,
      "description": "AKG file format version.",
      "title": "Format Version",
      "type": "integer"
    },
    "gaps": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/Gap"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gaps"
    },
    "graph": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraphInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "objective": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Objective"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "final"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "format_version",
    "status",
    "question",
    "datasets"
  ],
  "title": "AkgDocument",
  "type": "object"
}
