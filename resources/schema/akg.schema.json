{
  "$defs": {
    "ColumnFacts": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "synonyms": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synonyms"
        },
        "value_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Description"
        }
      },
      "title": "ColumnFacts",
      "type": "object"
    },
    "ColumnReference": {
      "additionalProperties": true,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "column"
      ],
      "title": "ColumnReference",
      "type": "object"
    },
    "ColumnUsage": {
      "additionalProperties": true,
      "properties": {
        "as": {
          "enum": [
            "measure",
            "count",
            "group",
            "filter",
            "time",
            "absence",
            "join_only",
            "output"
          ],
          "title": "As",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null,
          "description": "Filter value or threshold."
        }
      },
      "required": [
        "as"
      ],
      "title": "ColumnUsage",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": true,
      "description": "Two or more anchors compared on shared columns rather than joined to each other.",
      "properties": {
        "anchors": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Anchors",
          "type": "array"
        },
        "comparison": {
          "enum": [
            "coverage",
            "difference",
            "co_occurrence"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "shared_columns": {
          "items": {
            "$ref": "#/$defs/ColumnReference"
          },
          "minItems": 1,
          "title": "Shared Columns",
          "type": "array"
        }
      },
      "required": [
        "anchors",
        "shared_columns",
        "comparison"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": true,
      "description": "One graph dataset, keyed by `node_id` in the document.",
      "properties": {
        "columns": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/ColumnFacts"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "entity_definitions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/EntityDefinitionFacts"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Definitions"
        },
        "grain": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "const": "unknown",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grain"
        },
        "name": {
          "description": "descriptor.qualified_name",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source": {
          "description": "Accessor family, such as sqlite.",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "stats": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reserved for statistics once the graph serves them.",
          "title": "Stats"
        },
        "synonyms": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synonyms"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "DatasetUsage": {
      "additionalProperties": true,
      "description": "Agent reasoning about one dataset.",
      "properties": {
        "columns": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/ColumnUsage"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "anchor",
                "grouping",
                "filter",
                "bridge"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "title": "DatasetUsage",
      "type": "object"
    },
    "Direction": {
      "additionalProperties": true,
      "properties": {
        "match_existence": {
          "$ref": "#/$defs/MatchExistence"
        },
        "multiplicity": {
          "$ref": "#/$defs/Multiplicity"
        }
      },
      "required": [
        "multiplicity",
        "match_existence"
      ],
      "title": "Direction",
      "type": "object"
    },
    "Endpoint": {
      "additionalProperties": true,
      "properties": {
        "dataset_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dataset Columns",
          "type": "array"
        },
        "identity_id": {
          "minLength": 1,
          "title": "Identity Id",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "identity_id",
        "dataset_columns"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "EntityDefinitionFacts": {
      "additionalProperties": true,
      "properties": {
        "dataset_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dataset Columns",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Effective description: the definition's own, or its single raw column's.",
          "title": "Description"
        },
        "description_source": {
          "anyOf": [
            {
              "enum": [
                "entity",
                "column"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description Source"
        },
        "entity_universe": {
          "$ref": "#/$defs/EntityUniverse"
        },
        "identity_id": {
          "minLength": 1,
          "title": "Identity Id",
          "type": "string"
        }
      },
      "required": [
        "identity_id",
        "dataset_columns",
        "entity_universe"
      ],
      "title": "EntityDefinitionFacts",
      "type": "object"
    },
    "EntityUniverse": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "EntityUniverse",
      "type": "string"
    },
    "Gap": {
      "additionalProperties": true,
      "description": "Knowledge the objective needs that the graph cannot connect or supply.",
      "properties": {
        "datasets": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datasets"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "relationships": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationships"
        }
      },
      "required": [
        "description"
      ],
      "title": "Gap",
      "type": "object"
    },
    "GraphInfo": {
      "additionalProperties": true,
      "properties": {
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Snapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The served snapshot, recorded by `akg.py init`."
        }
      },
      "title": "GraphInfo",
      "type": "object"
    },
    "JsonValue": {},
    "MatchExistence": {
      "enum": [
        "always",
        "optional",
        "unknown"
      ],
      "title": "MatchExistence",
      "type": "string"
    },
    "Multiplicity": {
      "enum": [
        "1:1",
        "1:many",
        "many:1",
        "many:many",
        "unknown"
      ],
      "title": "Multiplicity",
      "type": "string"
    },
    "Relationship": {
      "additionalProperties": true,
      "description": "One graph relationship, keyed by its canonical edge ID in the document.",
      "properties": {
        "a_to_b": {
          "$ref": "#/$defs/Direction"
        },
        "b_to_a": {
          "$ref": "#/$defs/Direction"
        },
        "endpoint_a": {
          "$ref": "#/$defs/Endpoint"
        },
        "endpoint_b": {
          "$ref": "#/$defs/Endpoint"
        },
        "stats": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reserved for statistics once the graph serves them.",
          "title": "Stats"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationshipUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
