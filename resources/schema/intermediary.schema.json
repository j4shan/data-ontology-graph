{
  "$defs": {
    "ColumnMetadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        },
        "value_description": {
          "default": "",
          "title": "Value Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ColumnMetadata",
      "type": "object"
    },
    "DatasetAccessor": {
      "additionalProperties": false,
      "description": "A credential-free path of information to a dataset's data (`product/graph-model.md#2.6`).\n\nThe graph never follows, resolves, or interprets an accessor. Keys and values of ``labels``\nand ``properties`` are the contributor's choice.",
      "properties": {
        "endpoint": {
          "description": "Where the path of information starts, in any form: an address, URI, account identifier, connector-plugin connection name, or shared document.",
          "pattern": "\\S",
          "title": "Endpoint",
          "type": "string"
        },
        "kind": {
          "description": "Free-text name of the kind of system the endpoint belongs to.",
          "pattern": "\\S",
          "title": "Kind",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Labels",
          "type": "object"
        },
        "properties": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "minProperties": 1,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Properties"
        }
      },
      "required": [
        "kind",
        "endpoint"
      ],
      "title": "DatasetAccessor",
      "type": "object"
    },
    "DatasetDescriptor": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "qualified_name": {
          "minLength": 1,
          "title": "Qualified Name",
          "type": "string"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "qualified_name",
        "display_name"
      ],
      "title": "DatasetDescriptor",
      "type": "object"
    },
    "DatasetGrain": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/GrainComponent"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "components"
      ],
      "title": "DatasetGrain",
      "type": "object"
    },
    "EntityRelationship": {
      "additionalProperties": false,
      "properties": {
        "descriptions": {
          "description": "One nonblank, distinct description per way the two logical entities relate.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Descriptions",
          "type": "array"
        },
        "endpoints": {
          "description": "The unordered pair of logical entity IDs, in ascending lexical order. Both may name the same logical entity.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Endpoints",
          "type": "array"
        }
      },
      "required": [
        "endpoints",
        "descriptions"
      ],
      "title": "EntityRelationship",
      "type": "object"
    },
    "EntityUniverse": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "EntityUniverse",
      "type": "string"
    },
    "GrainComponent": {
      "additionalProperties": false,
      "properties": {
        "dataset_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dataset Columns",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "identity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Id"
        }
      },
      "required": [
        "dataset_columns"
      ],
      "title": "GrainComponent",
      "type": "object"
    },
    "IntermediaryEntityDefinition": {
      "additionalProperties": false,
      "properties": {
        "conforms": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ],
          "description": "Whether every non-null key value belongs to the logical entity's population, with no orphan values. A complete definition conforms by definition.",
          "title": "Conforms"
        },
        "dataset_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dataset Columns",
          "type": "array"
        },
        "description": {
          "default": "",
          "description": "What this realization identifies in its dataset, such as the role it plays. Write it when the key is composite or transformed, or when its column description does not say the role; a single unmodified column otherwise lends its column description.",
          "title": "Description",
          "type": "string"
        },
        "entity_expression": {
          "items": {
            "type": "string"
          },
          "title": "Entity Expression",
          "type": "array"
        },
        "entity_metadata": {
          "additionalProperties": true,
          "title": "Entity Metadata",
          "type": "object"
        },
        "entity_universe": {
          "$ref": "#/$defs/EntityUniverse"
        },
        "identity_id": {
          "minLength": 1,
          "title": "Identity Id",
          "type": "string"
        },
        "total": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ],
          "description": "Whether every record has a non-null key.",
          "title": "Total"
        },
        "unique": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ],
          "description": "Whether an instance of the logical entity appears in at most one record of the dataset. Records with a null key hold no instance.",
          "title": "Unique"
        }
      },
      "required": [
        "identity_id",
        "dataset_columns",
        "entity_universe",
        "unique",
        "total",
        "conforms"
      ],
      "title": "IntermediaryEntityDefinition",
      "type": "object"
    },
    "IntermediaryNode": {
      "additionalProperties": false,
      "properties": {
        "accessor": {
          "$ref": "#/$defs/DatasetAccessor"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnMetadata"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "descriptor": {
          "$ref": "#/$defs/DatasetDescriptor"
        },
        "entity_definitions": {
          "items": {
            "$ref": "#/$defs/IntermediaryEntityDefinition"
          },
          "title": "Entity Definitions",
          "type": "array"
        },
        "grain": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetGrain"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ],
          "title": "Grain"
        },
        "node_id": {
          "description": "Stable dataset identity chosen by the contributor and unique in the graph. It does not depend on accessor content; keep it while the accessor leads to the same data.",
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "descriptor",
        "accessor",
        "grain",
        "columns"
      ],
      "title": "IntermediaryNode",
      "type": "object"
    },
    "JsonValue": {},
    "LogicalIdentityDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "LogicalIdentityDefinition",
      "type": "object"
    },
    "Unknown": {
      "description": "Explicit unknown for a structured claim, such as a grain, that has no enum of its own.",
      "enum": [
        "unknown"
      ],
      "title": "Unknown",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entity_relationships": {
      "description": "Cross-entity relationships between registered logical entities.",
      "items": {
        "$ref": "#/$defs/EntityRelationship"
      },
      "title": "Cross-Entity Relationships",
      "type": "array"
    },
    "logical_identities": {
      "additionalProperties": {
        "$ref": "#/$defs/LogicalIdentityDefinition"
      },
      "minProperties": 1,
      "title": "Logical Entities",
      "type": "object"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/IntermediaryNode"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "schema_version": {
      "const": "5",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "logical_identities",
    "nodes"
  ],
  "title": "IntermediaryDefinition",
  "type": "object"
}
