{
  "$defs": {
    "ColumnMetadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        },
        "value_description": {
          "default": "",
          "title": "Value Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ColumnMetadata",
      "type": "object"
    },
    "DatasetAccessor": {
      "additionalProperties": false,
      "properties": {
        "properties": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Properties",
          "type": "object"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "properties"
      ],
      "title": "DatasetAccessor",
      "type": "object"
    },
    "DatasetDescriptor": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "qualified_name": {
          "minLength": 1,
          "title": "Qualified Name",
          "type": "string"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "qualified_name",
        "display_name"
      ],
      "title": "DatasetDescriptor",
      "type": "object"
    },
    "DatasetGrain": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/GrainComponent"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "components"
      ],
      "title": "DatasetGrain",
      "type": "object"
    },
    "EntityUniverse": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "EntityUniverse",
      "type": "string"
    },
    "GrainComponent": {
      "additionalProperties": false,
      "properties": {
        "dataset_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dataset Columns",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "identity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Id"
        }
      },
      "required": [
        "dataset_columns"
      ],
      "title": "GrainComponent",
      "type": "object"
    },
    "IntermediaryEntityDefinition": {
      "additionalProperties": false,
      "properties": {
        "conforms": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ],
          "description": "Whether every non-null key value belongs to the logical entity's population, with no orphan values. A complete definition conforms by definition.",
          "title": "Conforms"
        },
        "dataset_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dataset Columns",
          "type": "array"
        },
        "description": {
          "default": "",
          "description": "What this realization identifies in its dataset, such as the role it plays. Write it when the key is composite or transformed, or when its column description does not say the role; a single unmodified column otherwise lends its column description.",
          "title": "Description",
          "type": "string"
        },
        "entity_expression": {
          "items": {
            "type": "string"
          },
          "title": "Entity Expression",
          "type": "array"
        },
        "entity_metadata": {
          "additionalProperties": true,
          "title": "Entity Metadata",
          "type": "object"
        },
        "entity_universe": {
          "$ref": "#/$defs/EntityUniverse"
        },
        "identity_id": {
          "minLength": 1,
          "title": "Identity Id",
          "type": "string"
        },
        "total": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ],
          "description": "Whether every record has a non-null key.",
          "title": "Total"
        },
        "unique": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ],
          "description": "Whether an instance of the logical entity appears in at most one record of the dataset. Records with a null key hold no instance.",
          "title": "Unique"
        }
      },
      "required": [
        "identity_id",
        "dataset_columns",
        "entity_universe",
        "unique",
        "total",
        "conforms"
      ],
      "title": "IntermediaryEntityDefinition",
      "type": "object"
    },
    "IntermediaryNode": {
      "additionalProperties": false,
      "properties": {
        "accessor": {
          "$ref": "#/$defs/DatasetAccessor"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnMetadata"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "descriptor": {
          "$ref": "#/$defs/DatasetDescriptor"
        },
        "entity_definitions": {
          "items": {
            "$ref": "#/$defs/IntermediaryEntityDefinition"
          },
          "title": "Entity Definitions",
          "type": "array"
        },
        "grain": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetGrain"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ],
          "title": "Grain"
        },
        "node_id": {
          "description": "Stable dataset identity in the form <accessor-family>:<catalog>.<object>, where accessor-family is the middle segment of accessor.schema_id. Keep the value stable while the dataset remains at the same access location; a dataset served through a different accessor family is a different node.",
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "descriptor",
        "accessor",
        "grain",
        "columns"
      ],
      "title": "IntermediaryNode",
      "type": "object"
    },
    "JsonValue": {},
    "LogicalIdentityDefinition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "LogicalIdentityDefinition",
      "type": "object"
    },
    "Unknown": {
      "description": "Explicit unknown for a structured claim, such as a grain, that has no enum of its own.",
      "enum": [
        "unknown"
      ],
      "title": "Unknown",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "logical_identities": {
      "additionalProperties": {
        "$ref": "#/$defs/LogicalIdentityDefinition"
      },
      "minProperties": 1,
      "title": "Logical Entities",
      "type": "object"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/IntermediaryNode"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "schema_version": {
      "const": "4",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "logical_identities",
    "nodes"
  ],
  "title": "IntermediaryDefinition",
  "type": "object"
}
